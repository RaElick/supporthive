# База данных (по умолчанию SQLite в backend/)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/supporthive
DATABASE_URL=sqlite:///./supporthive.db
SECRET_KEY=change-me

# LLM: любой OpenAI-совместимый Chat Completions API. Пусто = эвристический режим.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CONTEXT_BUDGET_TOKENS=3000

# Telegram-бот (от @BotFather). Пусто = бот не запускается.
TELEGRAM_BOT_TOKEN=

ROUTING_STRATEGY=skills
ANOMALY_MINUTES_LOW_PRIORITY=30
CORS_ORIGINS=http://localhost:5173
